// g5ptq_q8x.comp - dp4a prefill GEMV for the 5-trit (PTQ1_0) path.
//
// Uses int8 activations quantised per 128-column group (amax/127, RNE) and int8
// trits, with dp4a (4 int8 x int8 -> int32) for the dot product. The group sum is
// scaled by x_scale * w_scale in fp32. This is exactly what the reference Kindi
// does for its prompt GEMM (k_q8x_T), and what llama.cpp does for q8_1 rows.
//
// Why prefill only, and why it is not exact fp32: the activation quantisation
// introduces int8 rounding. The reference documents this tradeoff explicitly:
// "Not exact fp32 arithmetic: the activations carry int8 rounding (llama.cpp's
// own matrix products do the same with q8_1 rows)." Decode stays float.
//
// Why this is 4x cheaper on the dot product: one dp4a instruction does 4 int8 x int8
// products and accumulates into an int32. On RDNA2 (6700 XT) integerDotProduct8Bit-
// SignedAccelerated is true, so dp4a is a single hardware instruction. On the 580
// (Polaris, gfx803) it is false, so this kernel is not usable there.
//
// The 5-trit packing is awkward for dp4a (5 does not divide into 4), so the kernel
// unpacks a whole 128-weight block's trits into int8 shared memory first, then does
// 32 dp4a instructions per token per block.
//
// Push: { int R; int C; int T; int xstride; }   T must be 4, x is [T][xstride]
// Bindings: 0 raw blocks as uint words, 1 x (float), 2 y (float, [T][R])
#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_shader_subgroup_basic : require
#extension GL_EXT_shader_subgroup_arithmetic : require
#extension GL_EXT_8bit_storage : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer BW { uint w[]; };
layout(set = 0, binding = 1) readonly buffer BX { float x[]; };
layout(set = 0, binding = 2) buffer BY { float y[]; };

layout(push_constant) uniform PC { int R; int C; int T; int xstride; } pc;

// Quantised x for one 128-column block, all 4 tokens.
shared int8_t xq[4][128];
// Unpacked int8 trits for one 128-weight block.
shared int8_t wq[128];

void main() {
    int row = int(gl_WorkGroupID.x);
    int R = pc.R, C = pc.C, T = pc.T, xs = pc.xstride;
    if (row >= R) return;

    int lane = int(gl_LocalInvocationID.x);
    int bpr = C >> 7;            // 128-weight blocks per row
    int ntb = bpr * 26;          // trit-bearing bytes per row (26 of the 28)

    // Process one 128-weight block at a time.
    for (int blk = 0; blk < bpr; ++blk) {
        // ---- Step 1: quantise x for this block to int8, for all 4 tokens ----
        // amax per token over the 128 columns of this block
        float amax[4] = float[4](0.0, 0.0, 0.0, 0.0);
        for (int i = lane; i < 128; i += 64) {
            int c = blk * 128 + i;
            for (int t = 0; t < 4; ++t) {
                amax[t] = max(amax[t], abs(x[t * xs + c]));
            }
        }
        for (int t = 0; t < 4; ++t) {
            amax[t] = subgroupMax(amax[t]);
        }
        float xscale[4];
        float inv_scale[4];
        for (int t = 0; t < 4; ++t) {
            xscale[t] = (amax[t] != 0.0) ? (amax[t] / 127.0) : 1e-6;
            inv_scale[t] = 1.0 / xscale[t];
        }

        // Each lane quantises 2 columns (128 / 64 = 2) for all 4 tokens.
        for (int i = 0; i < 2; ++i) {
            int c = lane * 2 + i;
            if (c < 128) {
                int col = blk * 128 + c;
                for (int t = 0; t < 4; ++t) {
                    float val = x[t * xs + col];
                    xq[t * 128 + c] = int8_t(clamp(round(val * inv_scale[t]), -127.0, 127.0));
                }
            }
        }
        barrier();

        // ---- Step 2: unpack 128 trits to int8 ----
        // Each lane handles 2 bytes (8 trits) of the 26 trit bytes.
        for (int bi = lane; bi < 26; bi += 64) {
            int off = bi;
            int blkbase = (row * bpr + blk) * 28;
            uint raw = (w[(blkbase + off) >> 2] >> (8u * ((blkbase + off) & 3))) & 0xFFu;
            int base = off * 5;   // trit index base for this byte (approximate)
            // unpack 5 (or 4) trits into wq
            if (off < 16) {
                for (int n = 0; n < 5; ++n) {
                    uint tr = (((raw * (1u << (2 * n))) & 0xFFu) * 3u) >> 8;  // wrong, fix below
                }
            }
        }
        barrier();

        // ---- Step 3: dp4a per 4 weights ----
        // ... (incomplete)
    }
}
