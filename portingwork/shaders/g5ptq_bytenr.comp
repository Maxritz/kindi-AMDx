// g5ptq_bytenr.comp - PTQ1_0 5-trit GEMV, RPW output rows per wave.
//
// Compiled once per rows-per-wave width (-DRPW=n) and selected at runtime from the
// device's actual subgroup size, so the wave is filled correctly on wave32, wave64 or
// wave128 hardware instead of assuming 64.
//
//   wave 128 -> RPW 1   (a wave already holds a full row's worth of lanes)
//   wave  64 -> RPW 2   (gfx803 / RX 580: the case this was written for)
//   wave  32 -> RPW 4   (RDNA and earlier 32-wide parts)
//
// The point is independent work per wave. With RPW rows the same x load feeds RPW
// accumulators, so x traffic falls by RPW and the scheduler gets RPW independent
// FMA chains. The accumulators are explicit scalars, not arrays indexed by a loop
// variable: a runtime-indexed array lands in scratch memory on GCN.
//
// Token axis: T rides gl_WorkGroupID.y (see the push constants). T workgroups per
// row-block share the same weight stream through L2 while keeping the proven
// 4-chain lane shape. Per-(row,token) FMA order is unchanged, so gy=T is
// bit-identical to T=1 (selftest-verified, including a non-contiguous xs).
//
// Inline trit decode: the same formula the old 5 KB tlf[] LUT was built from,
// evaluated per use. Identical inputs produce identical floats, so every row's
// FMA sequence is unchanged. Zero shared memory: the Xe-core keeps its full
// 160 KB L1 for the weight stream.
//
// SOFTWARE PIPELINE: the next iteration's weight bytes and scales are loaded
// BEFORE the current iteration's FMAs (2-stage). The FMA sequence per row is
// exactly the interleaved order — prefetches only fill registers — but the
// memory pipeline carries two iterations of independent loads per lane instead
// of one. Bit-identical by construction.
//
// SHERLOCKED (2026-10-28): x[] staged in SLM measured 20.6 -> 10.8 tok/s (SLM
// allocation drops L1 160->64 KB); a 3-phase uniform restructure measured 18.3
// vs the interleaved loop (loop setup + broken x locality beat the divergence
// win); RPW=8 measured 2.3x below RPW=4 (driver SIMD-width downgrade, not VGPR
// — Intel's register file is statically allocated). Do not re-add any of these
// without an occupancy-aware redesign.
//
// PTQ1_0 block = 128 weights in 28 bytes: 26 trit bytes then an fp16 scale at
// bytes 26..27. Each trit byte carries five base-3 digits (3^5 = 243 < 256).
//
// Push: { int R; int C; int T; int xs; }  (T=1, xs=C for the decode path)
// Bindings: 0 raw blocks as uint words, 1 x (float), 2 out (float)
#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#ifndef RPW
#define RPW 2
#endif
#define WGS 256
#define NSUB 8   // 256/32 with 32-lane subgroups (engine pins 32); 4 on GCN wave64 - 8 covers both

layout(local_size_x = WGS) in;

layout(set = 0, binding = 0) readonly buffer BW { uint w[]; };
layout(set = 0, binding = 1) readonly buffer BX { float x[]; };
layout(set = 0, binding = 2) buffer BO { float out_[]; };

layout(push_constant) uniform PC { int R; int C; int T; int xs; } pc;

const uint P3[5] = uint[5](1u, 3u, 9u, 27u, 81u);

uint block_byte(int row, int bpr, int blk, int byteInBlk) {
    int bi = (row * bpr + blk) * 28 + byteInBlk;
    return (w[bi >> 2] >> (8u * uint(bi & 3))) & 0xFFu;
}

// scale for block <blk> of <row>: bytes 26..27, and a block starts at a multiple of
// 28, so byte 26 is the high half of word (base/4 + 6)
float block_scale(int row, int bpr, int blk) {
    int sb = ((row * bpr + blk) * 28) >> 2;
    return unpackHalf2x16(w[sb + 6] >> 16).x;
}

float tritf(uint b, int n) {
    uint tr = (((b * P3[n]) & 0xFFu) * 3u) >> 8u;
    return float(tr) - 1.0f;
}
#define TRIT(B, N) tritf((B), (N))

void main() {
    uint sgsz = gl_SubgroupSize;
    uint nsub = uint(gl_WorkGroupSize.x) / sgsz;
    int sub = int(gl_SubgroupID);
    uint lane = gl_SubgroupInvocationID;

    int R = pc.R;
    int C = pc.C;
    int T = pc.T; if (T <= 0) T = 1;
    int xs = pc.xs; if (xs <= 0) xs = C;
    int tok = int(gl_WorkGroupID.y);

    int row0 = (int(gl_WorkGroupID.x) * int(nsub) + sub) * RPW;

    // clamp instead of return: every invocation must reach every barrier()
    int r0 = row0,     r1 = row0 + 1, r2 = row0 + 2, r3 = row0 + 3;
    bool k0 = r0 < R,  k1 = false,    k2 = false,    k3 = false;
#if RPW >= 2
    k1 = r1 < R;
#endif
#if RPW >= 4
    k2 = r2 < R; k3 = r3 < R;
#endif
    int r4 = 0, r5 = 0, r6 = 0, r7 = 0;   // only used at RPW >= 8 (declared
    bool k4 = false, k5 = false, k6 = false, k7 = false;   // unconditionally so
#if RPW >= 8                               // the RPW>=8 blocks compile at all widths)
    r4 = row0 + 4; r5 = row0 + 5; r6 = row0 + 6; r7 = row0 + 7;
    k4 = r4 < R; k5 = r5 < R; k6 = r6 < R; k7 = r7 < R;
#endif
    if (!k0) r0 = 0;
    if (!k1) r1 = 0;
    if (!k2) r2 = 0;
    if (!k3) r3 = 0;
#if RPW >= 8
    if (!k4) r4 = 0;
    if (!k5) r5 = 0;
    if (!k6) r6 = 0;
    if (!k7) r7 = 0;
#endif

    int bpr = C >> 7;
    int ntb = bpr * 26;

    float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, acc3 = 0.0;
    float acc4 = 0.0, acc5 = 0.0, acc6 = 0.0, acc7 = 0.0;   // dead at RPW < 8

    // ---- 2-stage software pipeline -----------------------------------------
    // n* hold the NEXT iteration's loads; the loop body consumes them and then
    // prefetches the iteration after. FMA order per row is exactly the
    // interleaved bi sequence.
    int bi = int(lane);
    int nblk = bi / 26; int noff = bi - nblk * 26; int nbase = nblk << 7;
    uint n50 = block_byte(r0, bpr, nblk, noff); float ns0 = block_scale(r0, bpr, nblk);
    uint n51 = 0; float ns1 = 0.0f; uint n52 = 0, n53 = 0; float ns2 = 0.0f, ns3 = 0.0f;
    if (RPW >= 2) { n51 = block_byte(r1, bpr, nblk, noff); ns1 = block_scale(r1, bpr, nblk); }
    if (RPW >= 4) { n52 = block_byte(r2, bpr, nblk, noff); ns2 = block_scale(r2, bpr, nblk);
                    n53 = block_byte(r3, bpr, nblk, noff); ns3 = block_scale(r3, bpr, nblk); }
    while (bi < ntb) {
        int blk = nblk, off = noff, base = nbase;
        uint b50 = n50; float sc0 = ns0;
        uint b51 = n51; float sc1 = ns1;
        uint b52 = n52; float sc2 = ns2;
        uint b53 = n53; float sc3 = ns3;
        int nxt = bi + int(sgsz);
        if (nxt < ntb) {
            nblk = nxt / 26; noff = nxt - nblk * 26; nbase = nblk << 7;
            n50 = block_byte(r0, bpr, nblk, noff); ns0 = block_scale(r0, bpr, nblk);
            if (RPW >= 2) { n51 = block_byte(r1, bpr, nblk, noff); ns1 = block_scale(r1, bpr, nblk); }
            if (RPW >= 4) { n52 = block_byte(r2, bpr, nblk, noff); ns2 = block_scale(r2, bpr, nblk);
                            n53 = block_byte(r3, bpr, nblk, noff); ns3 = block_scale(r3, bpr, nblk); }
        }

        float p0 = 0.0f, p1 = 0.0f, p2 = 0.0f, p3 = 0.0f;

        if (off < 16) {                    // five digits, stride 16
            for (int n = 0; n < 5; ++n) {
                float xv = x[tok * xs + base + off + (n << 4)];
                p0 += TRIT(b50, n) * xv;
#if RPW >= 2
                p1 += TRIT(b51, n) * xv;
#endif
#if RPW >= 4
                p2 += TRIT(b52, n) * xv;
                p3 += TRIT(b53, n) * xv;
#endif
            }
        } else if (off < 24) {             // five digits, stride 8, from trit 80
            int j = off - 16;
            for (int n = 0; n < 5; ++n) {
                float xv = x[tok * xs + base + 80 + j + (n << 3)];
                p0 += TRIT(b50, n) * xv;
#if RPW >= 2
                p1 += TRIT(b51, n) * xv;
#endif
#if RPW >= 4
                p2 += TRIT(b52, n) * xv;
                p3 += TRIT(b53, n) * xv;
#endif
            }
        } else {                           // four digits, from trit 120
            int j = off - 24;
            for (int n = 0; n < 4; ++n) {
                float xv = x[tok * xs + base + 120 + (n << 1) + j];
                p0 += TRIT(b50, n) * xv;
#if RPW >= 2
                p1 += TRIT(b51, n) * xv;
#endif
#if RPW >= 4
                p2 += TRIT(b52, n) * xv;
                p3 += TRIT(b53, n) * xv;
#endif
            }
        }
        acc0 += sc0 * p0;
#if RPW >= 2
        acc1 += sc1 * p1;
#endif
#if RPW >= 4
        acc2 += sc2 * p2;
        acc3 += sc3 * p3;
#endif
        bi = nxt;
    }

    // Per-row sums via subgroupAdd (no shared-memory tree, no barriers).
    acc0 = subgroupAdd(acc0);
#if RPW >= 2
    acc1 = subgroupAdd(acc1);
#endif
#if RPW >= 4
    acc2 = subgroupAdd(acc2);
    acc3 = subgroupAdd(acc3);
#endif
    if (lane == 0u) {
        if (k0) out_[tok * R + r0] = acc0;
#if RPW >= 2
        if (k1) out_[tok * R + r1] = acc1;
#endif
#if RPW >= 4
        if (k2) out_[tok * R + r2] = acc2;
        if (k3) out_[tok * R + r3] = acc3;
#endif
    }
}
