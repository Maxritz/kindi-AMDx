// topk.comp <- k_topk (top-k via binary search on threshold, one block of 1024)
// CUDA grid: 1 block, 1024 threads. t=tid, lane=t&31, w=t>>5.
//   hi=y[amax[0]], lo=hi-band; 17 iters: mid = (it==0)?lo:0.5*(lo+hi)
//   c = count(y[i]>=mid, i=t;i<n;i+=1024); warp-sum via shuffles 16..1,
//   lane==0 -> red[w]; tid==0: tot=sum red[32];
//     it==0: if tot<k hi=lo (whole band kept); else tot>=k: lo=mid else hi=mid
//   break if hi<=lo. Then collect y[i]>=lo with atomicAdd(cnt).
// Vulkan: local_size_x=1024, 1 workgroup. Warp sums via shared memory
//   (exact; avoids subgroupSize-64 vs warp-32 mismatch), same order of
//   operations and same tie/band semantics.
// Push constants: struct PC { int n; int k; float band; int cap; };
// Bindings (set=0):
//   0: readonly float y[] (n), 1: readonly int amax[1],
//   2: buffer uint cnt[1] (atomic, host-zeroed),
//   3: write int out_i[] (cap), 4: write float out_v[] (cap)
#version 450
layout(local_size_x = 1024) in;

layout(set = 0, binding = 0) readonly buffer By { float y[]; };
layout(set = 0, binding = 1) readonly buffer Bam { int amax[]; };
layout(set = 0, binding = 2) buffer Bcnt { uint cnt[]; };
layout(set = 0, binding = 3) buffer Boi { int out_i[]; };
layout(set = 0, binding = 4) buffer Bov { float out_v[]; };

layout(push_constant) uniform PC { int n; int k; float band; int cap; } pc;

shared int red[32];
shared int wc[1024];
shared float lo_s;
shared float hi_s;

void main() {
  uint t = gl_LocalInvocationID.x;
  uint lane = t & 31u;
  uint w = t >> 5;
  if (t == 0u) { hi_s = y[amax[0]]; lo_s = hi_s - pc.band; }
  barrier();
  for (int it = 0; it < 17; ++it) {
    float mid = (it == 0) ? lo_s : 0.5f * (lo_s + hi_s);
    int c = 0;
    for (int i = int(t); i < pc.n; i += 1024) c += (y[i] >= mid) ? 1 : 0;
    wc[t] = c;
    barrier();
    // warp-of-32 sum (shared-memory tree, same grouping as CUDA shuffles)
    for (int o = 16; o > 0; o >>= 1) {
      if (int(lane) < o) wc[w * 32u + lane] += wc[w * 32u + lane + uint(o)];
      barrier();
    }
    if (lane == 0u) red[w] = wc[w * 32u];
    barrier();
    if (t == 0u) {
      int tot = 0;
      for (int j = 0; j < 32; ++j) tot += red[j];
      if (it == 0) { if (tot < pc.k) hi_s = lo_s; }
      else if (tot >= pc.k) lo_s = mid;
      else hi_s = mid;
    }
    barrier();
    if (hi_s <= lo_s) break;
  }
  float thr = lo_s;
  for (int i = int(t); i < pc.n; i += 1024) {
    float v = y[i];
    if (v >= thr) {
      uint q = atomicAdd(cnt[0], 1u);
      if (int(q) < pc.cap) { out_i[q] = i; out_v[q] = v; }
    }
  }
}
