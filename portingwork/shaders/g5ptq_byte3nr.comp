// g5ptq_byte3nr.comp - PTQ1_0 5-trit GEMV, up to THREE tensors sharing one input,
// RPW rows per wave.
//
// Combines the two independent wins on this path:
//   - fusion: up to three tensors that read the same x in ONE dispatch, so the
//     COMPUTE->COMPUTE barrier between them disappears
//   - rows per wave: the same x load feeds RPW row accumulators, so x traffic falls
//     by RPW and the scheduler gets RPW independent FMA chains
//
// Compiled per width (-DRPW=n) and selected from the device's wave size, like the
// single-tensor kernel: wave128 -> 1, wave64 -> 2, wave32 -> 4.
//
// RPW=4 (wave32: Intel and RDNA) covers FOUR rows per wave. An earlier version only
// ever wrote rows base_row and base_row+1, so half of every wave block was left stale
// in the output buffer (the selftest caught it: 7.9e-01; on the RX 580 it never fired
// because wave64 selects RPW=2). Rows 2 and 3 are guarded by RPW >= 4.
//
// Layout of the wave space: the groups are laid out per tensor, so a wave's RPW rows
// always belong to the SAME tensor. That keeps the weight-buffer choice outside the
// inner loop. A first version of the fused kernel selected the buffer per byte with a
// 3-way ternary and measured 772 us/op against 563; the branch has to be per wave.
//
//     tensor0 groups: ceil(R0/RPW)
//     tensor1 groups: ceil(R1/RPW)
//     tensor2 groups: ceil(R2/RPW)
//
// Each row's accumulator receives exactly the FMA sequence the single-tensor kernel
// gives it, so every row is bit-identical and the spec invariant is untouched.
//
// PTQ1_0 block = 128 weights in 28 bytes: 26 trit bytes then an fp16 scale at
// bytes 26..27. Each trit byte carries five base-3 digits (3^5 = 243 < 256):
//   bytes  0..15 -> trits j, 16+j, 32+j, 48+j, 64+j        (j = 0..15)
//   bytes 16..23 -> trits 80+j, 88+j, 96+j, 104+j, 112+j   (j = 0..7)
//   bytes 24..25 -> trits 120+j, 122+j, 124+j, 126+j       (j = 0..1)
//
// Push: { int R0; int R1; int R2; int C; }
// Bindings: 0 W0 1 Y0 2 W1 3 Y1 4 W2 5 Y2 6 X
//
// SHERLOCKED (2026-10-28): x[] shared staging measured a large regression on the
// Intel iGPU (see g5ptq_bytenr.comp header) — occupancy loss from the extra
// shared bytes beats the global-load latency it removes. Direct x loads kept.
#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require   // subgroupAdd replaces the shared-memory tree + barriers

#ifndef RPW
#define RPW 2
#endif
#define WGS 256
#define NSUB 8   // 256/32 with 32-lane subgroups (engine pins 32); 4 on GCN wave64 - 8 covers both

layout(local_size_x = WGS) in;

layout(set = 0, binding = 0) readonly buffer W0B { uint W0[]; };
layout(set = 0, binding = 1) buffer Y0B { float Y0[]; };
layout(set = 0, binding = 2) readonly buffer W1B { uint W1[]; };
layout(set = 0, binding = 3) buffer Y1B { float Y1[]; };
layout(set = 0, binding = 4) readonly buffer W2B { uint W2[]; };
layout(set = 0, binding = 5) buffer Y2B { float Y2[]; };
layout(set = 0, binding = 6) readonly buffer XB { float x[]; };

layout(push_constant) uniform PC { int R0; int R1; int R2; int C; } pc;

// SLM freed: the trit LUT is gone (inline decode above), so this kernel uses
// zero shared memory — the full 160 KB L1 stays available to the weight stream.
const uint P3[5] = uint[5](1u, 3u, 9u, 27u, 81u);

// Inline trit decode — the SAME formula the old 5 KB tlf[] LUT was built from,
// evaluated per use (bit-identical: identical inputs, identical floats, same
// FMA sequence). Replaces ~260 shared-memory loads per lane with pipelined
// ALU and frees the 5 KB SLM (which was also shrinking the 160 KB L1 to 64 KB).
// See g5ptq_bytenr.comp for the full rationale.
float tritf(uint b, int n) {
    uint tr = (((b * P3[n]) & 0xFFu) * 3u) >> 8u;
    return float(tr) - 1.0f;
}
#define TRIT(B, N) tritf((B), (N))
// BPR is a DO_TENSOR parameter, so it must be passed IN: a nested macro body is not
// rescanned for the outer macro's parameters (C-preprocessor rule) - referencing BPR
// directly here compiled as an undeclared identifier and left the stale .spv in place.
#define RD_BYTE(W, ROW, BPR) ((W[(((ROW)*(BPR)+blk)*28+off) >> 2] >> (8u*uint((((ROW)*(BPR)+blk)*28+off) & 3))) & 0xFFu)
#define RD_SCALE(W, ROW, BPR) unpackHalf2x16(W[((ROW)*(BPR)+blk)*7+6] >> 16).x

// One tensor's row group (RPW rows). W is the weight buffer, Y the output, G the
// group index within this tensor, RR the row count of this tensor.
#define DO_TENSOR(W, Y, G, RR, BPR, NTB)                                    \
    {                                                                       \
        int base_row = (G) * RPW;                                           \
        int ra = base_row, rb = base_row + 1;                               \
        int rc = base_row + 2, rd = base_row + 3;                           \
        bool ka = ra < (RR), kb = false, kc = false, kd = false;            \
        if (RPW >= 2) kb = rb < (RR);                                       \
        if (RPW >= 4) { kc = rc < (RR); kd = rd < (RR); }                   \
        if (!ka) ra = 0;                                                    \
        if (!kb) rb = 0;                                                    \
        if (!kc) rc = 0;                                                    \
        if (!kd) rd = 0;                                                    \
        float accA = 0.0, accB = 0.0, accC = 0.0, accD = 0.0;               \
        for (int bi = int(lane); bi < (NTB); bi += int(sgsz)) {             \
            int blk = bi / 26;                                              \
            int off = bi - blk * 26;                                        \
            int bs = blk << 7;                                              \
            float sa = RD_SCALE(W, ra, BPR);                                     \
            uint b5a = RD_BYTE(W, ra, BPR);                                      \
            uint b5b = 0, b5c = 0, b5d = 0; float sb = 0.0, sc = 0.0, sd = 0.0; \
            if (RPW >= 2) {                                                 \
                sb = RD_SCALE(W, rb, BPR);                                       \
                b5b = RD_BYTE(W, rb, BPR);                                       \
            }                                                               \
            if (RPW >= 4) {                                                 \
                sc = RD_SCALE(W, rc, BPR);                                       \
                sd = RD_SCALE(W, rd, BPR);                                       \
                b5c = RD_BYTE(W, rc, BPR);                                       \
                b5d = RD_BYTE(W, rd, BPR);                                       \
            }                                                               \
            float pA = 0.0, pB = 0.0, pC = 0.0, pD = 0.0;                   \
            if (off < 16) {                                                 \
                for (int n = 0; n < 5; ++n) {                               \
                    float xv = x[bs + off + (n << 4)];                     \
                    pA += TRIT(b5a, n) * xv;                                \
                    if (RPW >= 2) pB += TRIT(b5b, n) * xv;                  \
                    if (RPW >= 4) { pC += TRIT(b5c, n) * xv; pD += TRIT(b5d, n) * xv; } \
                }                                                           \
            } else if (off < 24) {                                          \
                int j = off - 16;                                           \
                for (int n = 0; n < 5; ++n) {                               \
                    float xv = x[bs + 80 + j + (n << 3)];                  \
                    pA += TRIT(b5a, n) * xv;                                \
                    if (RPW >= 2) pB += TRIT(b5b, n) * xv;                  \
                    if (RPW >= 4) { pC += TRIT(b5c, n) * xv; pD += TRIT(b5d, n) * xv; } \
                }                                                           \
            } else {                                                        \
                int j = off - 24;                                           \
                for (int n = 0; n < 4; ++n) {                               \
                    float xv = x[bs + 120 + (n << 1) + j];                 \
                    pA += TRIT(b5a, n) * xv;                                \
                    if (RPW >= 2) pB += TRIT(b5b, n) * xv;                  \
                    if (RPW >= 4) { pC += TRIT(b5c, n) * xv; pD += TRIT(b5d, n) * xv; } \
                }                                                           \
            }                                                               \
            accA += sa * pA;                                                \
            if (RPW >= 2) accB += sb * pB;                                  \
            if (RPW >= 4) { accC += sc * pC; accD += sd * pD; }             \
        }                                                                   \
        accA = subgroupAdd(accA);                                               \
        if (RPW >= 2) accB = subgroupAdd(accB);                                 \
        if (RPW >= 4) { accC = subgroupAdd(accC); accD = subgroupAdd(accD); }   \
        if (lane == 0u) {                                                   \
            if (ka) (Y)[ra] = accA;                                        \
            if (kb) (Y)[rb] = accB;                                         \
            if (kc) (Y)[rc] = accC;                                         \
            if (kd) (Y)[rd] = accD;                                         \
        }                                                                   \
    }

void main() {
    uint sgsz = gl_SubgroupSize;
    uint nsub = uint(gl_WorkGroupSize.x) / sgsz;
    int sub = int(gl_SubgroupID);
    uint lane = gl_SubgroupInvocationID;

    int C = pc.C;

    // SLM is unused: no LUT, no staging, no barriers. Both the trit decode and
    // the per-row sums (subgroupAdd) stay in registers/ALU.
    int R0 = pc.R0, R1 = pc.R1, R2 = pc.R2;
    int bpr = C >> 7;
    int ntb = bpr * 26;

    int G0 = (R0 + RPW - 1) / RPW;
    int G1 = (R1 + RPW - 1) / RPW;
    int G2 = (R2 + RPW - 1) / RPW;

    int gid = int(gl_WorkGroupID.x) * int(nsub) + sub;

    // One branch per wave; the weight buffer is then statically known.
    if (gid < G0) {
        DO_TENSOR(W0, Y0, gid, R0, bpr, ntb)
    } else if (gid < G0 + G1) {
        DO_TENSOR(W1, Y1, gid - G0, R1, bpr, ntb)
    } else if (gid < G0 + G1 + G2) {
        DO_TENSOR(W2, Y2, gid - G0 - G1, R2, bpr, ntb)
    }
}
