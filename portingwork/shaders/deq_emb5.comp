// deq_emb5.comp — embedding row dequant from native PTQ1_0 blocks + Hadamard fold.
// One workgroup per token row; C = D. Mirrors deq_emb3 but reads raw 28-byte blocks
// (no host expansion) and folds over arbitrary HB (512, 1024, ...).
#version 450
layout(local_size_x = 1024) in;

layout(set = 0, binding = 0) readonly buffer BW { uint w[]; };
layout(set = 0, binding = 1) readonly buffer Bsg { float sg[]; };
layout(set = 0, binding = 2) buffer Bh { float h[]; };

layout(push_constant) uniform PC { int row; int C; int HB; } pc;

shared float x[8192];

float fp16_to_f32(uint bits) {
    uint sign = (bits >> 15) & 1u;
    uint exp  = (bits >> 10) & 0x1Fu;
    uint mant = bits & 0x3FFu;
    if (exp == 0u) { float v = float(mant)/1024.0*(1.0/16384.0); return sign==1u ? -v : v; }
    if (exp == 31u) return sign==1u ? -3.0e38 : 3.0e38;
    float v = (1.0 + float(mant)/1024.0) * exp2(float(int(exp) - 15));
    return sign==1u ? -v : v;
}
uint bbyte(int base, int byteInBlk) {
    int bi = base + byteInBlk;
    return (w[bi >> 2] >> (8u * uint(bi & 3))) & 0xFFu;
}
int btrit(int base, int i) {
    uint q;
    if (i < 80) {
        int n = i >> 4, j = i & 15;
        uint raw = bbyte(base, j);
        uint p = 1u; for (int t = 0; t < n; ++t) p *= 3u;
        q = (raw * p) & 0xFFu;
    } else if (i < 120) {
        int k = i - 80, n = k >> 3, j = k & 7;
        uint raw = bbyte(base, 16 + j);
        uint p = 1u; for (int t = 0; t < n; ++t) p *= 3u;
        q = (raw * p) & 0xFFu;
    } else {
        int k = i - 120, n = k >> 1, j = k & 1;
        uint raw = bbyte(base, 24 + j);
        uint p = 1u; for (int t = 0; t < n; ++t) p *= 3u;
        q = (raw * p) & 0xFFu;
    }
    return int((q * 3u) >> 8);
}

void main() {
    uint t = gl_LocalInvocationID.x;
    int C = pc.C, HB = pc.HB;
    int bpr = C >> 7;
    int rowbase = pc.row * bpr * 28;          // byte offset of this row's first block

    // dequant the row into shared
    for (int e = int(t); e < C; e += 1024) {
        int blk = e >> 7, i = e & 127;
        int base = rowbase + blk * 28;
        int trit = btrit(base, i);
        uint dlo = bbyte(base, 26), dhi = bbyte(base, 27);
        float sc = fp16_to_f32(dlo | (dhi << 8));
        x[e] = float(trit - 1) * sc;
    }
    barrier();

    // in-place FWHT per HB block, then sign + 1/sqrt(HB)
    for (int c0 = 0; c0 < C; c0 += HB) {
        for (int hh = 1; hh < HB; hh <<= 1) {
            // all invocations reach the barrier; only t < HB/2 do work
            for (int q = int(t); q < (HB >> 1); q += 1024) {
                int i = c0 + (q / hh) * 2 * hh + (q % hh);
                float a = x[i], b = x[i + hh];
                x[i] = a + b; x[i + hh] = a - b;
            }
            barrier();
        }
    }
    barrier();
    float s = inversesqrt(float(HB));
    for (int e = int(t); e < C; e += 1024) h[e] = sg[e] * (x[e] * s);
}
