// softmax_s.comp - row softmax with an external scale, ggml_soft_max_ext arithmetic
//   wp = s*scale; m = max(wp); p = expf(wp - m); sum in fp64; p *= (float)(1/sum)
//   bindings: 0 s(float, nh*n), in place
//   push: { int n; float scale; }   grid = nh
#version 450
// Intel iGPU port (shaderFloat64=false): dp4a/probe verified; fp64 ext not needed
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BS { float s[]; };

layout(push_constant) uniform PC { int n; float scale; } pc;

// Intel iGPU port (shaderFloat64=false): the exp-sum tree runs in fp32 (CPU mirror is fp32 too)
shared float red[256];
shared float dred[256];
shared float pmax;
shared float pinv;

void main() {
  int hh = int(gl_WorkGroupID.x);
  int t  = int(gl_LocalInvocationID.x);
  int n  = pc.n;
  int base = hh * n;

  float mx = -1e30;
  for (int i = t; i < n; i += 256) mx = max(mx, s[base + i] * pc.scale);
  red[t] = mx;
  barrier();
  for (int st = 128; st > 0; st >>= 1) {
    if (t < st) red[t] = max(red[t], red[t + st]);
    barrier();
  }
  if (t == 0) pmax = red[0];
  barrier();
  float m = pmax;

  float part = 0.0;
  for (int i = t; i < n; i += 256) part += exp(s[base + i] * pc.scale - m);
  dred[t] = part;
  barrier();
  for (int st = 128; st > 0; st >>= 1) {
    if (t < st) dred[t] += dred[t + st];
    barrier();
  }
  if (t == 0) pinv = 1.0f / dred[0];
  barrier();
  float inv = pinv;
  for (int i = t; i < n; i += 256) s[base + i] = exp(s[base + i] * pc.scale - m) * inv;
}
