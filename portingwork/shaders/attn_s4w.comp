#version 450
#extension GL_KHR_shader_subgroup_shuffle : require
// attn_s4w.comp <- k_attn_s4w (single-card 2B only: NH=8, NHKV=2, HD=256, G=4, scale 0.0625)
// CUDA grid/block mapping:
//   CUDA: grid (NHKV, ceil(n/32)), block 256 (8 warps of 32).
//         blockIdx.x = kv (0..NHKV-1); warp w of block covers positions gw*4+p,
//         gw = blockIdx.y*8 + warp, persistent stride nwarps*4, nwarps = gridDim.y*8.
//         lane = threadIdx.x & 31 -> dims 8l..8l+7; the 4 q-heads' q in registers.
// Vulkan: num workgroups (NHKV, ceil(n/32), 1), local_size_x = 256.
//         gl_WorkGroupID.x = kv, gl_WorkGroupID.y = blockIdx.y,
//         gl_LocalInvocationID.x = threadIdx.x, lane/warp derived identically.
//         Persistent t0 loop kept verbatim so any gridDim.y works.
// Push constants (8 B <= 128 B): int n (context length), int n_kv (NHKV=2).
// Buffers: Kh = fp16 BITS as uint[] (never dequantized on host). One CUDA uint4 =
//   4 uints here; word index ((t*n_kv+kv)*32+lane)*4+m. Decode with unpackHalf2x16.
//   q = float[NHKV*1024] (per kv: 4 heads x 256); s = float[NH* n], row (kv*4+j)*n+t.
// Arithmetic: q in registers, one K row per (p,lane), 4x4 dots, then the exact
//   straight-line 16-value butterfly (shuffles 16,8,4,2,1) from k_attn_s4w.
// SUBGROUP NOTE (64 vs warp 32): all shuffle masks are <32, so bit5 of the
//   subgroup index is preserved by idx^mask. One 64-lane subgroup = two adjacent
//   32-lane CUDA warps packed consecutively; no crosstalk. Requires subgroups of
//   consecutive invocations (true on gfx803 RADV/AMDGPU-PRO). No shared memory.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer KhBuf { uint Kh[]; };
layout(set = 0, binding = 1) readonly buffer QBuf { float q[]; };
layout(set = 0, binding = 2) buffer SBuf { float s[]; };

layout(push_constant) uniform PushConstants {
  int n;
  int n_kv;
} pc;

void main() {
  int kv = int(gl_WorkGroupID.x);
  int tid = int(gl_LocalInvocationID.x);
  int lane = tid & 31;
  int warp = tid >> 5;
  int gw = int(gl_WorkGroupID.y) * 8 + warp;
  int nwarps = int(gl_NumWorkGroups.y) * 8;
  int n = pc.n;
  int n_kv = pc.n_kv;
  if (gw * 4 >= n) return;

  // q in registers: qr[j][i], j = 0..3 heads of this kv, i = 0..7 dims
  float qr[32];
  for (int j = 0; j < 4; ++j) {
    int base = kv * 1024 + j * 256 + lane * 8;
    qr[j * 8 + 0] = q[base + 0];
    qr[j * 8 + 1] = q[base + 1];
    qr[j * 8 + 2] = q[base + 2];
    qr[j * 8 + 3] = q[base + 3];
    qr[j * 8 + 4] = q[base + 4];
    qr[j * 8 + 5] = q[base + 5];
    qr[j * 8 + 6] = q[base + 6];
    qr[j * 8 + 7] = q[base + 7];
  }

  for (int t0 = gw * 4; t0 < n; t0 += nwarps * 4) {
    float v[16];
    for (int p = 0; p < 4; ++p) {
      int t = min(t0 + p, n - 1);
      int wbase = ((t * n_kv + kv) * 32 + lane) * 4;
      uint ww0 = Kh[wbase + 0];
      uint ww1 = Kh[wbase + 1];
      uint ww2 = Kh[wbase + 2];
      uint ww3 = Kh[wbase + 3];
      vec2 h0v = unpackHalf2x16(ww0);
      vec2 h1v = unpackHalf2x16(ww1);
      vec2 h2v = unpackHalf2x16(ww2);
      vec2 h3v = unpackHalf2x16(ww3);
      float kk[8];
      kk[0] = h0v.x; kk[1] = h0v.y;
      kk[2] = h1v.x; kk[3] = h1v.y;
      kk[4] = h2v.x; kk[5] = h2v.y;
      kk[6] = h3v.x; kk[7] = h3v.y;
      for (int j = 0; j < 4; ++j) {
        float a = 0.0;
        a += kk[0] * qr[j * 8 + 0];
        a += kk[1] * qr[j * 8 + 1];
        a += kk[2] * qr[j * 8 + 2];
        a += kk[3] * qr[j * 8 + 3];
        a += kk[4] * qr[j * 8 + 4];
        a += kk[5] * qr[j * 8 + 5];
        a += kk[6] * qr[j * 8 + 6];
        a += kk[7] * qr[j * 8 + 7];
        v[p * 4 + j] = a;
      }
    }
    // Straight-line 16-value butterfly, exact order of k_attn_s4w.
    bool h0 = (lane & 16) != 0;
    float b0_0 = (h0 ? v[8] : v[0]) + subgroupShuffleXor(h0 ? v[0] : v[8], 16u);
    float b0_1 = (h0 ? v[9] : v[1]) + subgroupShuffleXor(h0 ? v[1] : v[9], 16u);
    float b0_2 = (h0 ? v[10] : v[2]) + subgroupShuffleXor(h0 ? v[2] : v[10], 16u);
    float b0_3 = (h0 ? v[11] : v[3]) + subgroupShuffleXor(h0 ? v[3] : v[11], 16u);
    float b0_4 = (h0 ? v[12] : v[4]) + subgroupShuffleXor(h0 ? v[4] : v[12], 16u);
    float b0_5 = (h0 ? v[13] : v[5]) + subgroupShuffleXor(h0 ? v[5] : v[13], 16u);
    float b0_6 = (h0 ? v[14] : v[6]) + subgroupShuffleXor(h0 ? v[6] : v[14], 16u);
    float b0_7 = (h0 ? v[15] : v[7]) + subgroupShuffleXor(h0 ? v[7] : v[15], 16u);
    bool h1 = (lane & 8) != 0;
    float b1_0 = (h1 ? b0_4 : b0_0) + subgroupShuffleXor(h1 ? b0_0 : b0_4, 8u);
    float b1_1 = (h1 ? b0_5 : b0_1) + subgroupShuffleXor(h1 ? b0_1 : b0_5, 8u);
    float b1_2 = (h1 ? b0_6 : b0_2) + subgroupShuffleXor(h1 ? b0_2 : b0_6, 8u);
    float b1_3 = (h1 ? b0_7 : b0_3) + subgroupShuffleXor(h1 ? b0_3 : b0_7, 8u);
    bool h2 = (lane & 4) != 0;
    float b2_0 = (h2 ? b1_2 : b1_0) + subgroupShuffleXor(h2 ? b1_0 : b1_2, 4u);
    float b2_1 = (h2 ? b1_3 : b1_1) + subgroupShuffleXor(h2 ? b1_1 : b1_3, 4u);
    bool h3 = (lane & 2) != 0;
    float b3_0 = (h3 ? b2_1 : b2_0) + subgroupShuffleXor(h3 ? b2_0 : b2_1, 2u);
    float b4_0 = b3_0 + subgroupShuffleXor(b3_0, 1u);
    v[0] = b4_0;

    int idx = ((lane >> 4) & 1) * 8 + ((lane >> 3) & 1) * 4 + ((lane >> 2) & 1) * 2 + ((lane >> 1) & 1);
    int t = t0 + (idx >> 2);
    int j = idx & 3;
    if (((lane & 1) == 0) && (t < n)) {
      s[(kv * 4 + j) * n + t] = v[0] * 0.0625;
    }
  }
}
