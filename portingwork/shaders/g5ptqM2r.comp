// g5ptqM2r.comp - PTQ1_0 5-trit GEMV, T tokens x RPW rows per wave.
//
// This is the speculative-verify kernel. It was left behind when the serial kernel got
// rows-per-wave: it ran at ~511 us/token against the serial kernel's 343, which made
// --spec a net LOSS (3.74 tok/s against 5.19). This restores the balance.
//
// Two independent axes of reuse, and they compose:
//
//   across tokens: one weight decode feeds T accumulators (this is what g5ptqM did)
//   across rows:   one x load feeds RPW accumulators (this is what was missing)
//
//     xv = x[t][c]                     one load per (token, column)
//     acc[r][t] += tlf[b5[r] + n] * xv  RPW*T FMAs from it
//
// The trit table is indexed per row, so it is fetched RPW times per byte rather than
// once per (row, token) - which is why the float table pays off here even though it
// lost on the old T=2-only kernel: there it replaced a register-resident packed word,
// here it is amortised over T tokens.
//
// Compiled per rows-per-wave width (-DRPW=n) and selected from the device's wave size:
// wave128 -> 1, wave64 -> 2, wave32 -> 4.
//
// RPW=4 (wave32: Intel and RDNA) needs FOUR rows, not two: an earlier version only
// ever wrote rows row0 and row0+1, so half of every 32-row workgroup block was left
// stale in the output buffer (selftest caught it: max|dy| = 7.9e-01 on the RX 580 it
// never fired because wave64 selects RPW=2). Rows 2 and 3 are guarded by RPW >= 4.
//
// Bit-identity: each (row, token) accumulator receives exactly the FMA sequence the
// single-row kernel gives it, so every value is bit-identical and the spec invariant
// (batched == single-token) is preserved. --selftest asserts 0.000e+00.
//
// PTQ1_0 block = 128 weights in 28 bytes: 26 trit bytes then an fp16 scale at
// bytes 26..27. Each trit byte carries five base-3 digits (3^5 = 243 < 256):
//   bytes  0..15 -> trits j, 16+j, 32+j, 48+j, 64+j        (j = 0..15)
//   bytes 16..23 -> trits 80+j, 88+j, 96+j, 104+j, 112+j   (j = 0..7)
//   bytes 24..25 -> trits 120+j, 122+j, 124+j, 126+j       (j = 0..1)
//
// Push: { int R; int C; int T; int xstride; }   x is token-major [T][xstride]
// Bindings: 0 raw blocks as uint words, 1 x, 2 out ([T][R])
#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require   // subgroupAdd replaces the shared-memory tree + barriers

#ifndef RPW
#define RPW 2
#endif
#define WGS 256
#define NSUB 8   // 256/32 with 32-lane subgroups (engine pins 32); 4 on GCN wave64 - 8 covers both

layout(local_size_x = WGS) in;

layout(set = 0, binding = 0) readonly buffer BW { uint w[]; };
layout(set = 0, binding = 1) readonly buffer BX { float x[]; };
layout(set = 0, binding = 2) buffer BO { float out_[]; };

layout(push_constant) uniform PC { int R; int C; int T; int xstride; } pc;

// Eight slots: four rows x two tokens. Fixed width so a constant index is always in
// range, and one reduction pass covers all of them.
shared float sh[NSUB][8][32];
shared float tlf[1280];

const uint P3[5] = uint[5](1u, 3u, 9u, 27u, 81u);

uint block_byte(int row, int bpr, int blk, int byteInBlk) {
    int bi = (row * bpr + blk) * 28 + byteInBlk;
    return (w[bi >> 2] >> (8u * uint(bi & 3))) & 0xFFu;
}

float block_scale(int row, int bpr, int blk) {
    int sb = ((row * bpr + blk) * 28) >> 2;
    return unpackHalf2x16(w[sb + 6] >> 16).x;
}

#define TRIT(B5, N) tlf[(B5) + (N)]

void main() {
    uint sgsz = gl_SubgroupSize;
    uint nsub = uint(gl_WorkGroupSize.x) / sgsz;
    int sub = int(gl_SubgroupID);
    uint lane = gl_SubgroupInvocationID;

    for (uint e = gl_LocalInvocationID.x; e < 256u; e += uint(gl_WorkGroupSize.x)) {
        for (int n = 0; n < 5; ++n) {
            uint tr = (((e * P3[n]) & 0xFFu) * 3u) >> 8;
            tlf[e * 5u + uint(n)] = float(int(tr) - 1);
        }
    }
    barrier();

    int R = pc.R;
    int C = pc.C;
    int T = pc.T;
    int xs = pc.xstride;
    int bpr = C >> 7;
    int ntb = bpr * 26;

    int row0 = (int(gl_WorkGroupID.x) * int(nsub) + sub) * RPW;
    int r0 = row0,     r1 = row0 + 1, r2 = row0 + 2, r3 = row0 + 3;
    bool k0 = r0 < R,  k1 = false,    k2 = false,    k3 = false;
#if RPW >= 2
    k1 = r1 < R;
#endif
#if RPW >= 4
    k2 = r2 < R; k3 = r3 < R;
#endif
    if (!k0) r0 = 0;
    if (!k1) r1 = 0;
    if (!k2) r2 = 0;
    if (!k3) r3 = 0;

    // Eight accumulate chains: four rows x two tokens. Explicit scalars, because an
    // array indexed by a runtime loop variable lands in scratch memory on GCN.
    float a00 = 0.0, a01 = 0.0;   // row0, tokens 0/1
    float a10 = 0.0, a11 = 0.0;   // row1
    float a20 = 0.0, a21 = 0.0;   // row2 (RPW >= 4)
    float a30 = 0.0, a31 = 0.0;   // row3 (RPW >= 4)

    for (int bi = int(lane); bi < ntb; bi += int(sgsz)) {
        int blk = bi / 26;
        int off = bi - blk * 26;
        int base = blk << 7;

        int b50 = int(block_byte(r0, bpr, blk, off)) * 5;
        float sc0 = block_scale(r0, bpr, blk);
#if RPW >= 2
        int b51 = int(block_byte(r1, bpr, blk, off)) * 5;
        float sc1 = block_scale(r1, bpr, blk);
#endif
#if RPW >= 4
        int b52 = int(block_byte(r2, bpr, blk, off)) * 5;
        float sc2 = block_scale(r2, bpr, blk);
        int b53 = int(block_byte(r3, bpr, blk, off)) * 5;
        float sc3 = block_scale(r3, bpr, blk);
#endif

        float p00 = 0.0, p01 = 0.0, p10 = 0.0, p11 = 0.0;
        float p20 = 0.0, p21 = 0.0, p30 = 0.0, p31 = 0.0;

        if (off < 16) {
            for (int n = 0; n < 5; ++n) {
                float xv0 = x[base + off + (n << 4)];
                float xv1 = x[xs + base + off + (n << 4)];
                p00 += TRIT(b50, n) * xv0;
                p01 += TRIT(b50, n) * xv1;
#if RPW >= 2
                p10 += TRIT(b51, n) * xv0;
                p11 += TRIT(b51, n) * xv1;
#endif
#if RPW >= 4
                p20 += TRIT(b52, n) * xv0;
                p21 += TRIT(b52, n) * xv1;
                p30 += TRIT(b53, n) * xv0;
                p31 += TRIT(b53, n) * xv1;
#endif
            }
        } else if (off < 24) {
            int j = off - 16;
            for (int n = 0; n < 5; ++n) {
                float xv0 = x[base + 80 + j + (n << 3)];
                float xv1 = x[xs + base + 80 + j + (n << 3)];
                p00 += TRIT(b50, n) * xv0;
                p01 += TRIT(b50, n) * xv1;
#if RPW >= 2
                p10 += TRIT(b51, n) * xv0;
                p11 += TRIT(b51, n) * xv1;
#endif
#if RPW >= 4
                p20 += TRIT(b52, n) * xv0;
                p21 += TRIT(b52, n) * xv1;
                p30 += TRIT(b53, n) * xv0;
                p31 += TRIT(b53, n) * xv1;
#endif
            }
        } else {
            int j = off - 24;
            for (int n = 0; n < 4; ++n) {
                float xv0 = x[base + 120 + (n << 1) + j];
                float xv1 = x[xs + base + 120 + (n << 1) + j];
                p00 += TRIT(b50, n) * xv0;
                p01 += TRIT(b50, n) * xv1;
#if RPW >= 2
                p10 += TRIT(b51, n) * xv0;
                p11 += TRIT(b51, n) * xv1;
#endif
#if RPW >= 4
                p20 += TRIT(b52, n) * xv0;
                p21 += TRIT(b52, n) * xv1;
                p30 += TRIT(b53, n) * xv0;
                p31 += TRIT(b53, n) * xv1;
#endif
            }
        }
        a00 += sc0 * p00;
        a01 += sc0 * p01;
#if RPW >= 2
        a10 += sc1 * p10;
        a11 += sc1 * p11;
#endif
#if RPW >= 4
        a20 += sc2 * p20;
        a21 += sc2 * p21;
        a30 += sc3 * p30;
        a31 += sc3 * p31;
#endif
    }

    // Per-row sums via subgroupAdd (no shared-memory tree, no barriers).
    float s00 = subgroupAdd(a00), s01 = subgroupAdd(a01);
#if RPW >= 2
    float s10 = subgroupAdd(a10), s11 = subgroupAdd(a11);
#endif
#if RPW >= 4
    float s20 = subgroupAdd(a20), s21 = subgroupAdd(a21);
    float s30 = subgroupAdd(a30), s31 = subgroupAdd(a31);
#endif
    if (lane == 0u) {
        if (k0) { out_[r0] = s00; out_[R + r0] = s01; }
#if RPW >= 2
        if (k1) { out_[r1] = s10; out_[R + r1] = s11; }
#endif
#if RPW >= 4
        if (k2) { out_[r2] = s20; out_[R + r2] = s21; }
        if (k3) { out_[r3] = s30; out_[R + r3] = s31; }
#endif
    }
}
